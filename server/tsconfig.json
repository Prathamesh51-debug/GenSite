{
  "compilerOptions": {
      "target": "ES2020",
      "module": "nodenext",
      "moduleResolution":"nodenext",
      "outDir": "./dist",
      "rootDir": "./src",
      "paths": {
          "@/*": ["./src/*"]
      },
      "strict": false,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
  },
  "include": [
      "./src/**/*.ts"
  ],
  "exclude": [
      "node_modules",
      "**/*.test.ts"
  ]
}