# ---- Database (Supabase) ----
# Runtime connection via the transaction pooler (port 6543, ?pgbouncer=true)
DATABASE_URL=
# Direct connection — used ONLY by Prisma migrations
DIRECT_URL=

# ---- Auth (better-auth) ----
BETTER_AUTH_SECRET=            # random secret for signing sessions
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:5173   # comma-separated allowed origins (also drives CORS + CSRF check)

# ---- AI (OpenRouter, OpenAI-compatible) ----
AI_API_KEY=
# Optional model overrides (comma-separated list / single model)
# Free/cheap tier defaults to the fast, reliable pair below (both paid but cheap).
# GEN_MODELS=openai/gpt-oss-120b,qwen/qwen3-coder
# GEN_MODEL=
# EDIT_MODEL=openai/gpt-oss-120b
# ENHANCE_MODEL=qwen/qwen3-coder
# Premium tier model (default openai/gpt-5-mini — best reliable quality).
# PREMIUM_MODEL=openai/gpt-5-mini

# ---- Live preview (experimental, off by default) ----
# Stream free-tier generations into the editor preview as they are written.
# STREAM_PREVIEW=true

# ---- Images (optional) ----
# Topic-matching stock photos; unset keeps the generated placeholder image URLs.
PEXELS_API_KEY=

# ---- Payments (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (optional) ----
# When set, verification/reset emails send via Resend and email verification is
# ENFORCED. When unset, links are logged to the console and verification is off.
RESEND_API_KEY=
EMAIL_FROM=GenSite <onboarding@resend.dev>

# ---- Sign-up abuse protection (all optional) ----
# Cloudflare Turnstile captcha on sign-up (pair with VITE_TURNSTILE_SITE_KEY on the client)
TURNSTILE_SECRET_KEY=
# Daily cap on AI actions by accounts that never paid (default 300; 0 disables)
FREE_DAILY_AI_CAP=
# Extra comma-separated email domains to block at sign-up
BLOCKED_EMAIL_DOMAINS=

# ---- Observability (all optional; each no-ops unless its key is set) ----
# Error monitoring
SENTRY_DSN=
# LLM tracing (cost/latency/tokens)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# ---- Misc ----
NODE_ENV=development
# PORT is injected by most hosts (Render); defaults to 3000 locally.
